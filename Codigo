#include <stdio.h>
#include <string.h>

int main(){

char palavra[20];
int shift;
int i;

printf("Digite uma palavra: ");
scanf("%s", palavra);

printf("Digite o valor do shift: ");
scanf("%d", &shift);

for (i=0;i< strlen(palavra);i++){
        palavra[i] = palavra[i] + shift;
}

printf("Palavra criptografa : %s\n", palavra);

}

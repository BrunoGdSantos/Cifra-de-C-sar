#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define TAM 16

// Funcao para verificar se a palavra possui somente letras
int palavraValida(char palavra[]) {
    int i;

    for (i = 0; palavra[i] != '\0'; i++) {
        if (!isalpha(palavra[i])) {
            return 0;
        }
    }

    return 1;
}

// Funcao para verificar se um numero e primo
int ehPrimo(int numero) {
    int i;

    if (numero < 2) {
        return 0;
    }

    for (i = 2; i < numero; i++) {
        if (numero % i == 0) {
            return 0;
        }
    }

    return 1;
}

// Gera o valor da Progressao Aritmetica
int gerarPA(int posicao) {
    int primeiro = 1;
    int razao = 2;

    return primeiro + posicao * razao;
}

// Gera o valor da Progressao Geometrica
int gerarPG(int posicao) {
    int primeiro = 1;
    int razao = 2;
    int resultado = primeiro;
    int i;

    for (i = 0; i < posicao; i++) {
        resultado = resultado * razao;
    }

    return resultado;
}

// Gera Fibonacci
int gerarFibonacci(int posicao) {
    int a = 1;
    int b = 1;
    int proximo;
    int i;

    if (posicao == 0 || posicao == 1) {
        return 1;
    }

    for (i = 2; i <= posicao; i++) {
        proximo = a + b;
        a = b;
        b = proximo;
    }

    return b;
}

// Gera o proximo numero primo
int gerarPrimo(int posicao) {
    int numero = 2;
    int contador = 0;

    while (1) {
        if (ehPrimo(numero)) {
            if (contador == posicao) {
                return numero;
            }

            contador++;
        }

        numero++;
    }
}

// Escolhe qual sequencia sera utilizada
int gerarSequencia(int tipo, int posicao) {

    switch (tipo) {

        case 1:
            return gerarPA(posicao);

        case 2:
            return gerarPG(posicao);

        case 3:
            return gerarFibonacci(posicao);

        case 4:
            return gerarPrimo(posicao);

        default:
            return 0;
    }
}

// Funcao responsavel pela criptografia
void criptografar(char palavra[], char resultado[], int shift, int tipo) {

    int i;
    int valorSequencia;
    int deslocamento;
    char letra;

    for (i = 0; palavra[i] != '\0'; i++) {

        letra = toupper(palavra[i]);

        valorSequencia = gerarSequencia(tipo, i);

        deslocamento = shift + valorSequencia;

        resultado[i] = ((letra - 'A' + deslocamento) % 26) + 'A';
    }

    resultado[i] = '\0';
}

// Grava o resultado em arquivo
void salvarResultado(char palavra[], char resultado[], int shift,
                     int tipo, int tamanho) {

    FILE *arquivo;

    arquivo = fopen("resultado_criptografia.txt", "w");

    if (arquivo == NULL) {
        printf("\nErro ao criar o arquivo!\n");
        return;
    }

    fprintf(arquivo, "Palavra original: %s\n", palavra);
    fprintf(arquivo, "Palavra codificada: %s\n", resultado);
    fprintf(arquivo, "SHIFT: %d\n", shift);
    fprintf(arquivo, "Tipo de sequencia: %d\n", tipo);
    fprintf(arquivo, "Quantidade de letras: %d\n", tamanho);

    fclose(arquivo);

    printf("\nResultado salvo em resultado_criptografia.txt\n");
}

// Grava um log da execucao
void salvarLog(char palavra[], char resultado[], int shift, int tipo) {

    FILE *log;

    log = fopen("log_criptografia.txt", "a");

    if (log == NULL) {
        printf("\nErro ao criar o arquivo de log!\n");
        return;
    }

    fprintf(log,
            "Execucao - Palavra: %s | Resultado: %s | SHIFT: %d | Tipo: %d\n",
            palavra, resultado, shift, tipo);

    fclose(log);
}

// Mostra as sequencias
void mostrarSequencias() {

    printf("\n===== TIPOS DE SEQUENCIA =====\n");
    printf("1 - Progressao Aritmetica (PA)\n");
    printf("2 - Progressao Geometrica (PG)\n");
    printf("3 - Fibonacci\n");
    printf("4 - Numeros Primos\n");
}

int main() {

    char palavra[TAM];
    char resultado[TAM];

    int shift;
    int tipo;
    int opcao;
    int tamanho;
    int i;

    do {

        printf("\n==============================\n");
        printf("   CRIPTOGRAFIA MATEMATICA\n");
        printf("==============================\n");
        printf("1 - Criptografar palavra\n");
        printf("2 - Mostrar sequencias\n");
        printf("3 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {

            printf("\nDigite uma palavra (ate 15 letras): ");
            scanf("%15s", palavra);

            tamanho = strlen(palavra);

            if (tamanho > 15) {
                printf("Erro: a palavra possui mais de 15 letras.\n");
                continue;
            }

            if (!palavraValida(palavra)) {
                printf("Erro: utilize somente letras sem acentos.\n");
                continue;
            }

            printf("Digite o valor do SHIFT: ");
            scanf("%d", &shift);

            mostrarSequencias();

            printf("Escolha a sequencia: ");
            scanf("%d", &tipo);

            if (tipo < 1 || tipo > 4) {
                printf("Tipo de sequencia invalido!\n");
                continue;
            }

            criptografar(palavra, resultado, shift, tipo);

            printf("\n===== RESULTADO =====\n");
            printf("Palavra original: %s\n", palavra);
            printf("Palavra criptografada: %s\n", resultado);

            printf("\nValores utilizados:\n");

            for (i = 0; i < tamanho; i++) {
                printf("%d ", gerarSequencia(tipo, i));
            }

            printf("\n");

            salvarResultado(
                palavra,
                resultado,
                shift,
                tipo,
                tamanho
            );

            salvarLog(
                palavra,
                resultado,
                shift,
                tipo
            );

        } else if (opcao == 2) {

            mostrarSequencias();

            printf("\nExemplos:\n");
            printf("PA: 1 3 5 7 9...\n");
            printf("PG: 1 2 4 8 16...\n");
            printf("Fibonacci: 1 1 2 3 5 8...\n");
            printf("Primos: 2 3 5 7 11 13...\n");

        } else if (opcao == 3) {

            printf("\nPrograma encerrado.\n");

        } else {

            printf("\nOpcao invalida!\n");
        }

    } while (opcao != 3);

    return 0;
}

#include <stdio.h>
#include <string.h>

int main() {

    char palavra[20];
    int shift;
    int i;

    int a = 1;
    int b = 1;
    int proximo;

    printf("Digite uma palavra: ");
    scanf("%s", palavra);

    printf("Digite o SHIFT: ");
    scanf("%d", &shift);

    for (i = 0; i < strlen(palavra); i++) {

        int deslocamento;

        deslocamento = shift + a;

        palavra[i] = palavra[i] + deslocamento;

        proximo = a + b;
        a = b;
        b = proximo;
    }

    printf("Palavra criptografada: %s\n", palavra);

    return 0;
}
